pipeline {

    agent any

    tools {
        maven 'maven3'
    }

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/mohammedhashimi-ma/simple-java-maven-app.git'
            }
        }

        stage('Build & Test') {
            steps {
                sh 'mvn -version'
                sh 'mvn clean package'
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'target/*.jar',
                    fingerprint: true
            }
        }
    }
}
